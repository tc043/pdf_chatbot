# Copy to .env and export the variables (the app reads the process environment;
# it does not load .env files itself). Everything here is optional.

# --- Secrets -----------------------------------------------------------------
# Fallback OpenAI key used when a user leaves the key box empty (see USE_SERVER_KEY).
# OPENAI_API_KEY=
# Basic auth for the web UI. Set both or neither.
# PDFCHAT_AUTH_USER=
# PDFCHAT_AUTH_PASSWORD=

# --- Serving -----------------------------------------------------------------
# PDFCHAT_HOST=127.0.0.1          # use 0.0.0.0 only behind authentication
# PDFCHAT_PORT=7860
# PDFCHAT_LOG_LEVEL=INFO
# PDFCHAT_USE_SERVER_KEY=true     # false = every user must bring their own key
# PDFCHAT_MAX_CONCURRENT_REQUESTS=2
# PDFCHAT_QUEUE_MAX_SIZE=20

# --- Models ------------------------------------------------------------------
# PDFCHAT_OPENAI_MODEL=gpt-4o-mini
# PDFCHAT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# PDFCHAT_LOCAL_MODEL=openbmb/MiniCPM5-1B-SFT
# PDFCHAT_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval ---------------------------------------------------------------
# PDFCHAT_CHUNK_SIZE=1000
# PDFCHAT_CHUNK_OVERLAP=200
# PDFCHAT_RETRIEVER_K=3
# PDFCHAT_HISTORY_TURNS=3         # earlier Q&A pairs used for follow-up questions; 0 = off
# PDFCHAT_RETRIEVAL_MODE=hybrid   # hybrid = vector + BM25 keyword search; vector = embeddings only
# PDFCHAT_CHROMA_DIR=./.chromadb
# PDFCHAT_INDEX_MAX_COUNT=0       # keep indexes for at most N PDFs (0 = unlimited)
# PDFCHAT_INDEX_MAX_AGE_DAYS=0    # delete indexes unused for N days (0 = never)

# --- OCR for scanned pages (needs the Tesseract program) ------------------------
# PDFCHAT_OCR=auto                # auto = use Tesseract when installed; off = never
# PDFCHAT_OCR_LANGUAGE=eng        # e.g. eng+deu; the language data must be installed
# PDFCHAT_OCR_MAX_PAGES=50        # PDFs with more pages needing OCR are rejected
# Optional: read scanned pages with your own OpenAI-compatible vision server instead.
# Page images are sent to it. Untested against a live server; see the README.
# PDFCHAT_OCR_ENGINE=tesseract    # or: remote
# PDFCHAT_OCR_REMOTE_URL=http://gpu-box:8000/v1
# PDFCHAT_OCR_REMOTE_MODEL=baidu/Unlimited-OCR
# PDFCHAT_OCR_REMOTE_API_KEY=
# PDFCHAT_OCR_REMOTE_TIMEOUT_S=120

# --- Limits and timeouts -------------------------------------------------------
# PDFCHAT_MAX_PDF_MB=25
# PDFCHAT_MAX_PDF_PAGES=300
# PDFCHAT_MAX_QUESTION_CHARS=2000
# PDFCHAT_OPENAI_TIMEOUT_S=60
# PDFCHAT_OPENAI_MAX_RETRIES=2
# PDFCHAT_LOCAL_TOKEN_TIMEOUT_S=120
